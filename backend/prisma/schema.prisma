datasource db {
  provider = "postgresql"
 
}

generator client {
  provider = "prisma-client-js"
}

enum Rol {
  CLIENTE
  TECNICO
  ADMIN
}

enum EstadoSolicitud {
  PENDIENTE   // Creada por el cliente, esperando asignación/respuesta
  ACEPTADA    // Técnico aceptó el trabajo
  RECHAZADA   // Técnico rechazó el trabajo
  EN_PROCESO  // Trabajo en ejecución
  FINALIZADA  // Trabajo completado
  CANCELADA   // Cancelada por el cliente o admin
}

model Usuario {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  nombre             String
  celular            String?   // opcional
  rol                Rol       @default(CLIENTE)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt

  // Relaciones
  solicitudesComoCliente SolicitudServicio[] @relation("SolicitudesComoCliente")
  solicitudesComoTecnico SolicitudServicio[] @relation("SolicitudesComoTecnico")
}

model SolicitudServicio {
  id                 String          @id @default(uuid())
  titulo             String
  descripcion        String
  categoria          String          // Ej: Plomería, Electricidad, Gas
  direccion          String
  estado             EstadoSolicitud @default(PENDIENTE)

  clienteId          String
  cliente            Usuario         @relation("SolicitudesComoCliente", fields: [clienteId], references: [id])

  tecnicoId          String?
  tecnico            Usuario?        @relation("SolicitudesComoTecnico", fields: [tecnicoId], references: [id])

  fechaCreacion      DateTime        @default(now())
  fechaActualizacion DateTime        @updatedAt
}
